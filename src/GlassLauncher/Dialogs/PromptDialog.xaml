<chrome:GlassWindow x:Class="GlassLauncher.Dialogs.PromptDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="clr-namespace:GlassLauncher.Chrome"
                    Title="重命名"
                    Width="420"
                    Height="188"
                    ResizeMode="NoResize"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner"
                    FontFamily="{StaticResource UiFont}"
                    CaptionHeight="0"
                    CornerRadius="14"
                    Backdrop="Acrylic"
                    TintColor="{DynamicResource AcrylicTint}">

    <!-- 和主窗口同一套玻璃分层：受光层 → 内容 → 边缘折射 → 顶部镜面高光 -->
    <Grid>
        <Border CornerRadius="14"
                Background="{DynamicResource WindowSheenBrush}"
                IsHitTestVisible="False" />

        <Grid Margin="22,16,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题行兼作拖动把手（CaptionHeight=0，避免顶部变成不可点击的标题区） -->
        <Border Grid.Row="0"
                Background="Transparent"
                MouseLeftButtonDown="OnHeaderMouseDown">
            <TextBlock x:Name="TitleText"
                       Text="重命名"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
        </Border>

        <TextBox x:Name="Input"
                 Grid.Row="1"
                 Margin="0,14,0,0"
                 Style="{StaticResource GlassTextBox}"
                 KeyDown="OnInputKeyDown" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消"
                    Style="{StaticResource DialogButton}"
                    Click="OnCancel"
                    IsCancel="True" />
            <Button Content="确定"
                    Style="{StaticResource PrimaryDialogButton}"
                    Margin="8,0,0,0"
                    Click="OnOk"
                    IsDefault="True" />
        </StackPanel>
        </Grid>

        <Border CornerRadius="14"
                BorderThickness="1"
                BorderBrush="{DynamicResource WindowEdgeBrush}"
                IsHitTestVisible="False" />

        <Border Height="1"
                VerticalAlignment="Top"
                Margin="18,0,18,0"
                Background="{DynamicResource TopSpecularBrush}"
                IsHitTestVisible="False" />
    </Grid>
</chrome:GlassWindow>
