<chrome:GlassWindow x:Class="GlassLauncher.MainWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="clr-namespace:GlassLauncher.Chrome"
                    Title="应用程序"
                    Icon="/app.ico"
                    Width="840"
                    Height="560"
                    MinWidth="680"
                    MinHeight="460"
                    FontFamily="{StaticResource UiFont}"
                    CaptionHeight="44"
                    CornerRadius="8"
                    Backdrop="Acrylic"
                    TintColor="{DynamicResource AcrylicTint}">

    <!--
        玻璃是“叠”出来的，不是画出来的：一层负责调子，一层负责厚度，最后一层负责高光。
        层层都是渐变，任何一层换成纯色都会立刻变成一块塑料板。

        ⓪ 那一层（GlassSurface）是给“光学模式”用的实验通道：抓取窗口背后的真实像素、
        自己做模糊/折射/高光，能解决 DWM Acrylic 失焦退化成灰板的问题。但它有两个
        绕不过去的代价 —— 抓图前必须临时打开截屏排除（一开一关 = 闪一帧），以及圆角
        要自己裁（和 DWM 的玻璃框叠在一起会发毛）。所以默认不开，需要时用
        GLASSLAUNCHER_BACKDROP=optical 显式切换。
    -->
    <Grid x:Name="Shell" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <!--
                整窗变换：打开时从 1.05 缩到 1、关闭时缩到 0.94 再淡出 ——
                macOS 启动台打开/关闭的那一下“呼吸”。只动 RenderTransform，不碰布局。
            -->
            <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <!-- ⓪ 光学玻璃：整窗唯一的“背景”，下面是真实桌面，上面是内容 -->
        <Image x:Name="GlassSurface"
               Stretch="Fill"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <!--
            ①' 底色洗涤层：系统浅色 Acrylic 会把壁纸洗成灰白（实测蓝壁纸只剩 117,137,184 且发灰），
            深色 Acrylic 的颜色保真得多（41,73,143）。所以亮色主题改成「深色基底 + 我们自己刷一层浅色」，
            这样既保留壁纸的蓝，又不会让深色文字失去对比。暗色主题这层是透明的。
        -->
        <!--
            ⓪' 背景冻结层（全时 + live）：DWM 的系统 Acrylic 有两个绕不开的毛病 ——
            失焦退化成不透明的灰板（系统规则），聚焦态的实时模糊又浓得糊成一坨（同样不可调）。
            所以聚焦和失焦统一走这一层：抓一帧真实背景（截屏排除保证抓到的不是自己），
            GPU 高斯模糊后盖在上面。
            拖动期间不抓屏（build 26300 上排除+拖动 = DWM 停止呈现窗口），
            用拖动前的冻结帧随窗移动，松手后重新锚定桌面。抓屏时机见 MainWindow.xaml.cs 的注释。
        -->
        <Grid x:Name="FrozenBackdropHost"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <!--
                负边距 = 抓屏垫边（MainWindow.BackdropPad，两处必须一致）：
                抓屏区域比窗口四周各大 48，这里同样放大 48，Stretch=Fill 恰好 1:1 映射，
                背景内容与桌面像素级对齐；模糊的边缘淡出区落在窗外。
                FrozenShift 是拖动中的位移预测（抵消"背景慢半拍"），静止时归零。
            -->
            <Image x:Name="FrozenSurface"
                   Margin="-48"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="LowQuality">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="FrozenShift" X="0" Y="0" />
                </Image.RenderTransform>
                <Image.Effect>
                    <!-- 半径 12：用户验收的浓度。DWM 的实时模糊已不参与显示，这个值就是唯一的模糊来源 -->
                    <BlurEffect Radius="12" KernelType="Gaussian" />
                </Image.Effect>
            </Image>
            <!--
                交叉淡入的"新帧层"：松手重新锚定时新背景从它上面淡入，
                完成后换到 FrozenSurface 底上。避免新旧帧硬切造成的背景跳变。
                与 FrozenSurface 同几何（Margin/Stretch/模糊），只是没有位移变换 ——
                淡入只发生在静止状态，不需要位移预测。
            -->
            <Image x:Name="FrozenSurfaceAlt"
                   Margin="-48"
                   Stretch="Fill"
                   Opacity="0"
                   RenderOptions.BitmapScalingMode="LowQuality">
                <Image.Effect>
                    <BlurEffect Radius="12" KernelType="Gaussian" />
                </Image.Effect>
            </Image>
        </Grid>

        <Border x:Name="WashLayer"
                CornerRadius="0"
                Background="{DynamicResource GlassWashBrush}"
                IsHitTestVisible="False" />

        <!-- ① 整体受光：顶部微亮、底部微暗，给窗口一个“厚度” -->
        <Border x:Name="SheenLayer"
                CornerRadius="0"
                Background="{DynamicResource WindowSheenBrush}"
                IsHitTestVisible="False" />

        <!-- ② 内容层 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <!--
                标题栏：严格对照 macOS 启动台 —— 没有标题、没有徽标，只有顶部正中一条
                半透明搜索栏和右上角一枚圆形齿轮按钮（设置入口）。程序名交给任务栏显示。
                拖动窗口 / 双击最大化仍由 WindowChrome 的 CaptionHeight 区域提供。
            -->
            <!--
                布局结构（防悬停裁切的关键）：
                滚动区（DropSurface，下面声明）跨全部三行、从窗口顶端开始 ——
                视口裁切线就是窗口边缘，图标悬停放大的部分永远不会撞上一条
                “窗口内部的裁切线”；标题栏 + 药丸行凭 ZIndex=2 悬浮在滚动区上方，
                滚动时图标从它们背后穿过，与 macOS 启动台行为一致。
                滚动条隐藏（Launchpad 也没有），滚轮照常滚。
                WindowChrome 拖动：顶部 44px 标题区里 DropSurface 默认不可命中，
                空白处照常拖窗口。
            -->

            <Grid Grid.Row="0"
                  Panel.ZIndex="2">
                <!-- 中央搜索栏：mac 启动台的搜索框是一枚深色半透明胶囊，白字，居中 -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="260"
                        Height="30"
                        CornerRadius="15"
                        Background="{DynamicResource SearchSurfaceBrush}"
                        BorderBrush="{DynamicResource SearchBorderBrush}"
                        BorderThickness="1"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 放大镜（Segoe MDL2 Assets 的 Search 字形），与 mac 启动台一致 -->
                        <TextBlock Grid.Column="0"
                                   Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12.5"
                                   Margin="11,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SearchGlyphBrush}" />

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Margin="7,0,4,1.5"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="12.5"
                                 CaretBrush="{StaticResource TextPrimaryBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 TextChanged="OnSearchTextChanged"
                                 PreviewKeyDown="OnSearchKeyDown" />

                        <!-- 占位文字：搜索框为空时显示，非 mac 的“裸灰字”做法（没有 placeholder 控件可用） -->
                        <TextBlock x:Name="SearchHint"
                                   Grid.Column="1"
                                   Text="搜索"
                                   FontSize="12.5"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{StaticResource SearchGlyphBrush}" />

                        <!-- 清空按钮：有输入时出现，Esc 也能清 -->
                        <Button x:Name="SearchClear"
                                Grid.Column="2"
                                Width="18"
                                Height="18"
                                Margin="0,0,7,0"
                                Visibility="Collapsed"
                                Click="OnSearchClearClick"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Ellipse x:Name="Dot" Fill="#2E000000" Width="16" Height="16" />
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Dot" Property="Fill" Value="#42000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 右上角齿轮：打开设置页（原来的减号/最小化去掉了，任务栏右键一样能最小化） -->
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0"
                        Width="30"
                        Height="30"
                        ToolTip="设置"
                        Click="OnSettingsClick"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Ellipse x:Name="Ring"
                                         Width="26"
                                         Height="26"
                                         Fill="Transparent"
                                         Stroke="{StaticResource WindowEdgeBrush}"
                                         StrokeThickness="1.2" />
                                <TextBlock Text="&#xE713;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12.5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Fill" Value="#1E000000" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!--
                分类标签行：mac 启动台标题下面是一排药丸标签。
                我们的数据模型没有分组字段（Id/DisplayName/TargetPath/...，硬约束），
                所以只放一枚选中的“全部”，视觉结构与 mac 对齐，不做假分组。
            -->
            <StackPanel Grid.Row="1"
                        Panel.ZIndex="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="20,0,20,0">
                <Border CornerRadius="9.5"
                        Padding="11,3.5"
                        Background="{StaticResource PillSelectedBrush}">
                    <TextBlock Text="全部"
                               FontSize="11.5"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>
            </StackPanel>

            <!-- 拖拽接收区：外部文件拖入与网格内排序共用同一套 DragOver / Drop。
                 跨三行全高：视口裁切线 = 窗口边缘，悬停放大永不撞内部裁切线 -->
            <Border x:Name="DropSurface"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Margin="18,0,18,0"
                    CornerRadius="16"
                    Background="{DynamicResource PanelSurfaceBrush}"
                    AllowDrop="True"
                    DragEnter="OnDragEnter"
                    DragOver="OnDragOver"
                    DragLeave="OnDragLeave"
                    Drop="OnDrop">

            <!--
                内容 Grid：铺满 DropSurface（header/药丸凭 ZIndex 浮在其上）。

                ⚠ 悬停裁切 bug 的真正根源（两次"缩小标题层"都治不好的原因）：
                ScrollViewer.Padding 实际落在内部 ScrollContentPresenter 的 Margin 上，
                而 Presenter 的裁剪框从 padding 边缘开始 —— 裁切线永远钉在第一行图标的
                静止顶边上，悬停放大的部分（顶部 3~7px）全被它裁掉。
                所以滚动区内边距必须放在【内容元素的 Margin】上（margin 区不在裁剪框内，
                放大的图标可以自由探出），ScrollViewer 自身 Padding 保持 0。
            -->
            <Grid>
                    <!-- 条目网格 -->
                    <ScrollViewer x:Name="GridScroller"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <!--
                            内部排序不再用 gong-wpf-dragdrop：
                            它走 OLE DoDragDrop，鼠标位置只能从 DragOver 里拿，事件频率不受控，
                            而且它的预览是个收不干净的 Popup（之前那个幽灵图标就是它）。
                            现在由 MainWindow 自己接 MouseDown/Move/Up，1:1 跟手，见 MainWindow.xaml.cs。
                            这个 ItemsControl 只负责排版和承接外部文件拖放。
                        -->
                        <!-- Margin 14,92,6,16：内边距放内容上而不是 ScrollViewer.Padding，
                             见上方 ⚠ 注释。滚动后顶部 margin 滚出视口，图标贴到窗口边（Launchpad 同款） -->
                        <ItemsControl x:Name="AppItems"
                                      Margin="14,92,6,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel x:Name="AppWrapPanel" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="Root"
                                          Width="112"
                                          Height="122"
                                          Margin="4,0"
                                          RenderTransformOrigin="0.5,0.5"
                                          Background="Transparent"
                                          Cursor="Hand"
                                          ToolTip="{Binding TargetPath}"
                                          MouseLeftButtonDown="OnItemMouseLeftButtonDown"
                                          MouseMove="OnItemMouseMove"
                                          MouseLeftButtonUp="OnItemMouseLeftButtonUp"
                                          LostMouseCapture="OnItemLostMouseCapture">

                                        <!--
                                            ContextMenu 不在可视树里，不会继承条目的 DataContext，
                                            所以显式绑到 PlacementTarget.DataContext，菜单命令才拿得到“对哪个条目操作”。
                                        -->
                                        <Grid.ContextMenu>
                                            <ContextMenu Style="{StaticResource ItemContextMenu}"
                                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="打开"
                                                          Style="{StaticResource ItemMenuItem}"
                                                          Click="OnMenuLaunch" />
                                                <MenuItem Header="以管理员身份运行"
                                                          Style="{StaticResource ItemMenuItem}"
                                                          Click="OnMenuRunAsAdmin" />
                                                <Separator Style="{StaticResource ItemMenuSeparator}" />
                                                <MenuItem Header="重命名…"
                                                          Style="{StaticResource ItemMenuItem}"
                                                          Click="OnMenuRename" />
                                                <MenuItem Header="重新指定目标…"
                                                          Style="{StaticResource ItemMenuItem}"
                                                          Click="OnMenuRetarget" />
                                                <Separator Style="{StaticResource ItemMenuSeparator}" />
                                                <MenuItem Header="在资源管理器中打开"
                                                          Style="{StaticResource ItemMenuItem}"
                                                          Click="OnMenuReveal" />
                                                <MenuItem Header="移除"
                                                          Style="{StaticResource ItemMenuItem}"
                                                          Click="OnMenuRemove" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <Grid.RenderTransform>
                                            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                                        </Grid.RenderTransform>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="80" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!--
                                            白色 squircle 底板：mac 启动台里每个图标都站在一块白色圆角方块上
                                            （那是 mac 图标自带的），Windows 图标没有，必须自己补。
                                            不补的后果就是整排图标深浅不一、方圆各异 —— “不像 mac”的最大单一来源。
                                        -->
                                        <Border x:Name="Tile"
                                                Width="68"
                                                Height="68"
                                                CornerRadius="17"
                                                BorderThickness="1"
                                                Background="{StaticResource IconPlateBrush}"
                                                BorderBrush="{StaticResource IconPlateBorderBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </Border.RenderTransform>

                                            <Grid>
                                                <TextBlock Text="{Binding Initial}"
                                                           FontSize="21"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource ItemInitialBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!--
                                                    圆角遮罩：Windows 的图标是方的，macOS 的应用图标全是 squircle。
                                                    不裁这一步，方形图标（7z、终端这类）边角会硬得像贴纸，
                                                    也就是“裁剪不干净”最明显的一处。
                                                    半径 14.5/64 ≈ 22.6%，接近 macOS 图标的圆角比例。
                                                -->
                                                <Image x:Name="IconImage"
                                                       Source="{Binding Icon}"
                                                       Width="56"
                                                       Height="56"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,56,56"
                                                                           RadiusX="12.5"
                                                                           RadiusY="12.5" />
                                                    </Image.Clip>
                                                </Image>

                                                <!-- 失效角标：目标路径不存在时叠在图标右上角。
                                                     不用负边距，否则超出容器边界的那一半会被裁掉。 -->
                                                <Border x:Name="BrokenBadge"
                                                        Width="17"
                                                        Height="17"
                                                        CornerRadius="8.5"
                                                        Background="{StaticResource WarningBrush}"
                                                        BorderBrush="#FFFFFF"
                                                        BorderThickness="1.5"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="!"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <TextBlock x:Name="NameText"
                                                   Grid.Row="1"
                                                   Text="{Binding DisplayName}"
                                                   Margin="2,8,2,0"
                                                   FontSize="11.5"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="32"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <!-- 悬停：底色换成玻璃片 + 轻微放大，进出各 130ms，像按下去又弹起 -->
                                        <EventTrigger SourceName="Root" RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Tile"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                     To="1.10" Duration="0:0:0.34">
                                                        <DoubleAnimation.EasingFunction>
                                                            <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="Tile"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     To="1.10" Duration="0:0:0.34">
                                                        <DoubleAnimation.EasingFunction>
                                                            <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                        <EventTrigger SourceName="Root" RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Tile"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                     To="1" Duration="0:0:0.20">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="Tile"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     To="1" Duration="0:0:0.20">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                        <!-- 失效条目：图标降透明度 + 角标 + 名字变次要色 -->
                                        <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                            <Setter TargetName="BrokenBadge" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="IconImage" Property="Opacity" Value="0.42" />
                                            <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                                        </DataTrigger>

                                        <!--
                                            正在被拖拽：整格隐去，把位置让给浮起的副本。
                                            用进出各一段淡入淡出，而不是直接切 0/1，
                                            这样“拿起”和“落回”都不会有一下硬跳。
                                            挂在数据上（IsDragging），Move 之后容器重新绑定也不会认错条目。
                                        -->
                                        <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.08" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:0.12" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态提示（无条目 / 搜索无结果共用，文案由 UpdateEmptyState 切换） -->
                    <StackPanel x:Name="EmptyHint"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock x:Name="EmptyTitle"
                                   Text="把程序或快捷方式拖进来"
                                   HorizontalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="EmptySub"
                                   Text="支持 .lnk / .url / .exe / 文件夹，可以直接拖到两个图标之间插入"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- 外部拖入高亮 + 插入位置指示线（内部排序只用指示线） -->
                    <Border x:Name="DropHighlight"
                            CornerRadius="15"
                            BorderThickness="2"
                            BorderBrush="#4D0A84FF"
                            Background="#140A84FF"
                            Visibility="Collapsed"
                            IsHitTestVisible="False" />

                    <Canvas x:Name="DropLayer" IsHitTestVisible="False">
                        <Border x:Name="InsertLine"
                                Width="3"
                                Height="70"
                                CornerRadius="1.5"
                                Background="#0A84FF"
                                Visibility="Collapsed" />
                    </Canvas>

                    <!-- 底部状态条：解析失败 / 启动失败时给出原因，不弹窗打断 -->
                    <Border x:Name="StatusBar"
                            VerticalAlignment="Bottom"
                            Margin="12"
                            Padding="9,6"
                            CornerRadius="9"
                            Background="{DynamicResource MenuSurfaceBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="StatusText"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--
            ③ 边缘折射：1px，左上亮、右下暗，玻璃的“棱”全靠这一圈。
            圆角半径必须与 DWM 的系统裁剪半径（≈8，DWMWCP_ROUND 定死、不可自定义）一致：
            之前画 20px 弧线，而 DWM 按 ~8px 裁 —— 角上“弧线外、裁剪内”的月牙窄条
            露出没刷白纱的原始模糊图，就是“边角没裁干净”的来源。
            WashLayer/SheenLayer 干脆不设圆角整片铺满（反正被 DWM 裁），只有描边需要贴着弧线。
        -->
        <Border x:Name="EdgeLayer"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource WindowEdgeBrush}"
                IsHitTestVisible="False" />

        <!-- ③' 内侧再压一道极细暗线：外白内暗，边缘才有厚度（只留白线会像贴纸） -->
        <Border x:Name="InnerLineLayer"
                CornerRadius="7"
                Margin="1"
                BorderThickness="1"
                BorderBrush="{DynamicResource WindowInnerLineBrush}"
                IsHitTestVisible="False" />

        <!-- ④ 顶部镜面高光：窗口最上面那一道 1px 亮线，两端淡出 -->
        <Border x:Name="SpecularLayer"
                Height="1"
                VerticalAlignment="Top"
                Margin="22,0,22,0"
                Background="{DynamicResource TopSpecularBrush}"
                IsHitTestVisible="False" />

        <!--
            ⑤ 自绘拖拽预览层：盖住整窗（含标题栏），不吃鼠标事件。
            预览元素在拖拽开始时动态创建、拖拽结束时立刻清掉，生命周期完全由我们掌控。
        -->
        <Canvas x:Name="DragLayer"
                Panel.ZIndex="50"
                IsHitTestVisible="False" />
    </Grid>

    <chrome:GlassWindow.Triggers>
        <!--
            打开动画（macOS 启动台）：整块玻璃从 1.05 缩到 1 + 淡入，
            图标再按顺序弹入（见 PlayEntrance），两段叠在一起就是“涌出来”的手感。
        -->
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Shell"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.30" />
                    <DoubleAnimation Storyboard.TargetName="ShellScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="1.05" To="1" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ShellScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="1.05" To="1" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </chrome:GlassWindow.Triggers>
</chrome:GlassWindow>
